UMS_CONFIG_PATH=configs/config.yaml
UMS_DB_URL=postgres://postgres:postgres@localhost:5433/ums_db?sslmode=disable
UMS_REDIS_ADDR=localhost:6380
UMS_REDIS_PASSWORD=redis_password
UMS_JWT_PRIVATE_KEY_PATH=configs/ums_rsa_private.pem
UMS_JWT_PUBLIC_KEY_PATH=configs/ums_rsa_public.pem
UMS_JWT_ACCESS_TTL=15m
UMS_JWT_REFRESH_TTL=168h
UMS_JWT_ISSUER=ums
UMS_JWT_KEY_ID=ums-rsa-1
UMS_APP_PORT=8081
UMS_APP_ENV=development
UMS_APP_DEBUG=true
UMS_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
UMS_RATE_LIMIT_LOGIN_WINDOW_SECS=300
UMS_RATE_LIMIT_LOCK_DURATION_MINS=30
