# ================================================
# feature_orbit_server 环境变量模板
# 复制为 .env 并填写实际值
# ================================================

# 应用配置
APP_NAME=feature_orbit_server
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=feature_orbit_server
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

# 完整数据库连接 URL（供 migrate 工具使用）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/feature_orbit_server?sslmode=disable

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=168

# 日志配置
LOG_LEVEL=debug
LOG_FORMAT=json
